# USAGE — environment variable NAMES only. Never commit real values.
#
# Local development uses the Supabase CLI stack:
#   npm run db:start     (requires Docker)
#   npm run db:reset     (applies supabase/migrations + seed.sql)
# `supabase start` prints the URL and keys below.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses RLS. Used exclusively by trusted ingestion.
# Never expose to the browser, never log.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Allows the development-only demo ingestion action outside dev.
# Leave unset in production.
USAGE_ALLOW_DEMO_INGEST=
