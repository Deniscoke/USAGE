# USAGE — environment variable NAMES only. Never commit real values.
#
# Local development uses the Supabase CLI stack:
#   npm run db:start     (requires Docker)
#   npm run db:reset     (applies supabase/migrations + seed.sql)
# `supabase start` prints the URL and keys below.

NEXT_PUBLIC_SUPABASE_URL=
# Browser key. Public by design; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon JWT, still accepted if a project predates publishable keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses RLS. Used exclusively by trusted ingestion.
# Never expose to the browser, never log. Store as a Vercel SENSITIVE variable.
SUPABASE_SECRET_KEY=
# Legacy service_role JWT, still accepted.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Allows the development-only demo ingestion action outside dev.
# Leave unset in production.
USAGE_ALLOW_DEMO_INGEST=

# Vercel AI Gateway (server-side only, never NEXT_PUBLIC_).
# Used only by the development probe: npm run usage:gateway:probe -- --confirm
AI_GATEWAY_API_KEY=
# Optional. Pins the probe model; otherwise the cheapest available is resolved.
USAGE_PROBE_MODEL=

# USAGE Gateway (miner path). Server-side only.
# Set to "production" ONLY on trusted hosted infrastructure: it is what makes
# observed usage economically valid. Anything else stays development-trust.
USAGE_TRUST_ENVIRONMENT=
# Override the upstream base URL (defaults to the Vercel Claude Code surface).
USAGE_UPSTREAM_BASE_URL=
# Per-miner requests per minute (in-memory, single process).
USAGE_MINER_RPM=
# Development miner credential: the HASH only, from `npm run miner:token`.
USAGE_DEV_MINER_TOKEN_HASH=
USAGE_DEV_MINER_USER_ID=

# ---------------------------------------------------------------- proof issuance
# The root of trust. A deployment holding this private key can issue CONFIRMED,
# signed proofs; nothing else can, whatever it claims about itself.
# Generate a key pair with: npm run usage:signing-key
# Paste the PRIVATE key into Vercel as a Sensitive environment variable.
# NEVER put a real private key in this file, in git, or in a client bundle.
USAGE_RECEIPT_SIGNING_PRIVATE_KEY=
USAGE_RECEIPT_SIGNING_KEY_ID=
USAGE_RECEIPT_ISSUER=
# Public verification keys, {"key-id":"base64-spki"}. Not a secret: publish it.
USAGE_RECEIPT_PUBLIC_KEYS=

# ------------------------------------------------- deployment identity (optional)
# When set, the gateway cryptographically verifies its own Vercel deployment
# identity (project/team/environment) from the signed x-vercel-oidc-token before
# issuing production proofs. Leave unset to rely on the signing key alone.
USAGE_VERCEL_OIDC_ISSUER=
USAGE_VERCEL_PROJECT_ID=
USAGE_VERCEL_OWNER_ID=
USAGE_VERCEL_ENVIRONMENT=
