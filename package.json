{
  "name": "usage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "usage:gateway:probe": "node --env-file-if-exists=.env.local --import tsx scripts/gateway-probe.ts",
    "miner:token": "node --env-file-if-exists=.env.local --import tsx scripts/miner-token.ts",
    "miner:claude": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-claude-miner.ps1",
    "miner:summary": "node --env-file-if-exists=.env.local --import tsx scripts/miner-summary.ts",
    "usage:signing-key": "node --import tsx scripts/generate-signing-key.ts",
    "usage:verify-receipt": "node --env-file-if-exists=.env.local --import tsx scripts/verify-receipt.ts",
    "usage:verify-hosted": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/verify-hosted.ts",
    "usage:pricing:snapshot": "node --env-file-if-exists=.env.local --import tsx scripts/generate-pricing-snapshot.ts",
    "usage:pricing:publish": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/publish-pricing.ts",
    "usage:providers:publish": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/publish-providers.ts",
    "usage:secrets:migrate": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/migrate-secrets-to-vault.ts",
    "usage:settle-epoch": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/settle-epoch.ts",
    "usage:connections": "node --env-file-if-exists=.env.local --import tsx scripts/inspect-connections.ts",
    "usage:e2e:openrouter": "node --env-file-if-exists=.env.local --import tsx scripts/e2e-openrouter.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "ai": "^6.0.277",
    "jose": "^6.2.12",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
